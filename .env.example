# --- DATABASE ---
# Use mongodb://mongo:27017/ems for local Docker setup
# Use your Atlas URI for production/remote database
MONGO_URI=mongodb://mongo:27017/ems

# --- BACKEND SERVER ---
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost

# --- REDIS ---
REDIS_URL=redis://redis:6379

# --- SECURITY ---
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# --- AI MICROSERVICE ---
AI_SERVICE_URL=http://ai-service:8000
